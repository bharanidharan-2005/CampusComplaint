# Core
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQL Server)
DB_ENGINE=mssql
DB_NAME=SmartCampusDB
DB_USER=sa
DB_PASSWORD=CampusAdmin123!
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_CERT=yes
DB_TIMEOUT=30

# JWT
JWT_ACCESS_DAYS=1
JWT_REFRESH_DAYS=7

# CORS (comma separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# Email (leave as console for local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@campus.local
